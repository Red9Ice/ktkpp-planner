# База данных (PostgreSQL в облаке Supabase или Neon.tech)
# Пример: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/college_timetable

# Telegram-бот (токен от @BotFather и ID администраторов)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_IDS=[123456789]

# MAX-бот (токен платформы MAX)
MAX_BOT_TOKEN=your_max_bot_token_here

# Сервер вебхуков (Render.com / Koyeb)
WEBHOOK_URL=https://your-service-name.onrender.com
WEBHOOK_SECRET=your_secret_random_token_here
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# Интеграция с GitHub Actions (для облачного запуска Solver)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPO=Red9Ice/ktkpp-planner
GITHUB_WORKFLOW_ID=run_solver.yml

# Настройки решателя (Solver)
SOLVER_MAX_TIME_SECONDS=600
SOLVER_NUM_WORKERS=8
